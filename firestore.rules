// ============================================================
// firestore.rules
// কেন এই ফাইলটা আছে: এটাই প্রজেক্টের সবচেয়ে ঝুঁকিপূর্ণ অংশ (স্পেক ১০.৫)।
// UI দিয়ে কোনো permission hide করলে সেটা আসল সুরক্ষা না — এখানে যা লেখা
// আছে সেটাই server-side এ enforce হবে, browser dev tools দিয়েও bypass
// করা যাবে না।
//
// ডেপ্লয় করার আগে অবশ্যই Firebase Console > Firestore > Rules-এ গিয়ে
// Rules Simulator দিয়ে টেস্ট করে নিও (স্পেক ১০.৫ এর শেষ লাইন)।
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ⚠️ সতর্কতা: এই get() কল প্রতিটা rule চেক-এ extra read খরচ করে।
    // আমরা ইচ্ছাকৃতভাবে এটা শুধু role-চেক-এর জন্য ব্যবহার করছি (users collection ছোট,
    // প্রতি ইউজার প্রতি request-এ একবারই লাগে), কিন্তু batch-permission-এর মতো
    // ঘন ঘন হওয়া write-এ get() এড়িয়ে denormalization ব্যবহার করা হয়েছে (নিচে দেখো,
    // স্পেক ১৫.১)।
    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }

    function isHeadAdmin() {
      return isSignedIn() && myRole() == 'head_admin';
    }

    function isAdmin() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'head_admin');
    }

    function isTeacher() {
      return isSignedIn() && myRole() == 'teacher';
    }

    function myAssignedBatch() {
      return myProfile().assignedBatch;
    }

    // ---------- users ----------
    match /users/{userId} {
      // নিজের প্রোফাইল read করতে কোনো get() লাগবে না — সরাসরি uid মিলিয়ে দেখা হচ্ছে।
      // এটা জরুরি: isAdmin()/myRole() নিজেই users/{request.auth.uid} read করে, তাই
      // এখানে isAdmin() কল করলে rule নিজেকেই recursively ট্রিগার করত, আর Firestore
      // সেই recursive read নিজে থেকেই deny করে দেয় (design অনুযায়ী) — এটাই লগইনের
      // পর অ্যাপ চিরকাল "loading" দেখানোর আসল কারণ ছিল।
      allow read: if isSignedIn() && request.auth.uid == userId;

      // অন্য কারো প্রোফাইল Admin/Head Admin পড়তে পারবে — myRole() এখানে ঠিক
      // একবারই get() করে (নিজের ডকুমেন্ট, userId নয়), তাই recursion হয় না।
      allow read: if isSignedIn() && (myRole() == 'admin' || myRole() == 'head_admin');

      // সাইন-আপের সময় ইউজার নিজেই নিজের ডকুমেন্ট বানায়, কিন্তু role সবসময় null থাকতে হবে
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == null;

      // শুধু Head Admin role/batch আপডেট করতে পারবে
      allow update: if isHeadAdmin();

      // pending user remove করা (শুধু role==null অবস্থায়, শুধু Head Admin)
      allow delete: if isHeadAdmin();
    }

    // ---------- config (signup toggle) ----------
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isHeadAdmin();
    }

    // ---------- batches ----------
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow create, delete: if isHeadAdmin();

      // batch আপডেট (allowed_editors টগল, fee rate পরিবর্তন ইত্যাদি):
      // - Head Admin সবসময় পারবে
      // - Teacher নিজের ব্যাচের allowed_editors টগল করতে পারবে (শুধু ঐ ফিল্ড)
      // - Admin নতুন fee category / rate change করতে পারবে
      allow update: if isHeadAdmin()
                    || (isTeacher() && myAssignedBatch() == batchId)
                    || isAdmin();
    }

    // ---------- students ----------
    match /students/{studentId} {
      // সবাই (Teacher/Admin) পড়তে পারবে; UI নিজে থেকেই filter করে দেখাবে,
      // কিন্তু এখানে read খোলা রাখা হয়েছে কারণ Teacher-এর query filter
      // (currentBatch == myAssignedBatch) নিজেই scope করে দেয়
      allow read: if isSignedIn();

      allow create: if isTeacher() || isAdmin();

      // ছাত্র ডাটা এডিট: Teacher নিজের ব্যাচের (allowed_editors টগল যাচাই দরকার
      // fee/attendance-এর জন্য, কিন্তু ছাত্রের মূল প্রোফাইল এডিটে Teacher নিজের
      // ব্যাচেই যথেষ্ট), Admin সবসময় সব ব্যাচে পারবে (স্পেক ৩.১)
      allow update: if isHeadAdmin()
                    || isAdmin()
                    || (isTeacher() && resource.data.currentBatch == myAssignedBatch());

      // Delete: Teacher (নিজের batch) + Head Admin (স্পেক ৪.৩)
      allow delete: if isHeadAdmin()
                    || (isTeacher() && resource.data.currentBatch == myAssignedBatch());
    }

    // ---------- counters (HAS code generation) ----------
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin(); // transaction-এর ভেতরেই আপডেট হবে
    }

    // ---------- attendance ----------
    match /attendance/{attId} {
      allow read: if isSignedIn();

      // নতুন entry তৈরি: শুধু নিজের ব্যাচের Teacher বা যেকোনো Admin,
      // আর createdAt অবশ্যই server timestamp হতে হবে (client date না, স্পেক ১৫.৩)
      allow create: if (isAdmin() || (isTeacher() && request.resource.data.batchId == myAssignedBatch()))
                    && request.resource.data.createdAt == request.time;

      // এডিট: Admin/Head Admin সবসময়; Teacher শুধু ৭ দিনের মধ্যে, নিজের ব্যাচে,
      // আর createdAt ফিল্ড কখনো পরিবর্তন করা যাবে না (immutable, স্পেক ১৫.৩)
      allow update: if request.resource.data.createdAt == resource.data.createdAt
                    && (
                      isAdmin()
                      || (
                        isTeacher()
                        && resource.data.batchId == myAssignedBatch()
                        && request.time < resource.data.createdAt + duration.value(7, 'd')
                      )
                    );

      // Delete শুধু student delete-এর সময় batch operation-এ হয় (students.js দেখো)
      allow delete: if isHeadAdmin() || (isTeacher() && resource.data.batchId == myAssignedBatch());
    }

    // ---------- fees ----------
    match /fees/{feeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.batchId == myAssignedBatch());
      // Fee entry ভুলবশত এডিট/ডিলিট রোধ করতে এখন এটা Admin-only রাখা হয়েছে;
      // ভবিষ্যতে দরকার হলে correction flow যোগ করা যাবে
      allow update, delete: if isAdmin();
    }

    // ---------- feeCategories ----------
    match /feeCategories/{catId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin(); // majority voting লাগবে না (স্পেক ৩.৪)
    }

    // ---------- pending_requests ----------
    match /pending_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() || isAdmin();

      // আপডেট: type অনুযায়ী আলাদা নিয়ম — app logic-এর উপর ভরসা না করে
      // এখানেই সঠিক অনুমতি enforce করা হয়, browser dev tools দিয়ে bypass করা যাবে না।
      allow update: if
        // fee_status_change: শুধু Admin/Head Admin approve/reject করতে পারবে
        (resource.data.type == 'fee_status_change' && isAdmin())
        // batch_transfer: শুধু Admin/Head Admin approve/reject করতে পারবে
        || (resource.data.type == 'batch_transfer' && isAdmin())
        // teacher_removal: majority voting — status field সরাসরি বদলানো যাবে না
        // এখানে; শুধু 'approvals' array-তে নিজের uid যোগ করা যাবে (vote), অথবা
        // Head Admin চূড়ান্ত করতে পারবে transaction-driven finalize-এর মাধ্যমে
        || (
          resource.data.type == 'teacher_removal'
          && isAdmin()
          && resource.data.status == 'pending'
          && (
            // ভোট দেওয়া: শুধু approvals array বদলায়, status/payload অপরিবর্তিত থাকে,
            // আর নিজের uid ছাড়া অন্য কারো uid যোগ করা যাবে না
            (
              request.resource.data.status == 'pending'
              && request.resource.data.approvals.hasAll(resource.data.approvals)
              && request.resource.data.approvals.hasOnly(resource.data.approvals.concat([request.auth.uid]))
            )
            // অথবা Head Admin চূড়ান্ত করছে (status approved/rejected করছে)
            || isHeadAdmin()
          )
        )
        // teacher_removal cleanup ধাপ: majority vote-এ আগেই approved হয়ে যাওয়া
        // request-এ Head Admin শুধু roleCleared: false → true করতে পারবে, অন্য
        // কোনো ফিল্ড বদলাতে পারবে না
        || (
          resource.data.type == 'teacher_removal'
          && resource.data.status == 'approved'
          && isHeadAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleCleared'])
          && request.resource.data.roleCleared == true
        );

      allow delete: if isHeadAdmin();
    }

    // ---------- scheduled_transfers ----------
    match /scheduled_transfers/{id} {
      allow read: if isSignedIn();
      allow create: if isTeacher() || isAdmin();
      allow update: if isSignedIn(); // applyDueScheduledTransfers() যেকোনো লগইন করা ইউজার থেকেই ট্রিগার হতে পারে
    }

    // ---------- deleted_students_archive ----------
    match /deleted_students_archive/{id} {
      // শুধুমাত্র Head Admin পড়তে/এক্সপোর্ট করতে পারবে (স্পেক ৪.৩)
      allow read: if isHeadAdmin();
      // যেকোনো Teacher/Admin যারা delete করছে তারা archive-এ create করবে
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isHeadAdmin();
    }

    // ---------- activity_log ----------
    match /activity_log/{logId} {
      // সবাই পড়তে পারবে (transparency, স্পেক ১১)
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // শুধু Head Admin delete করতে পারবে (স্পেক ১১)
      allow delete: if isHeadAdmin();
      allow update: if false; // লগ কখনো এডিট হবে না, শুধু তৈরি বা ডিলিট
    }
  }
}
